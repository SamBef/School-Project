# Database (PostgreSQL). Use same value for both for Supabase or local.
# Supabase: Project Settings → Database → Connection string (URI). Replace [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# Optional, dev only: set to 1 if you see a TLS/credentials error on Windows (e.g. "No credentials are available in the security package"). Never set in production.
# DATABASE_INSECURE_SSL=0

# JWT secret — long, random string. Never commit the real value.
JWT_SECRET="your-jwt-secret-change-in-production"

# Email — Gmail / SMTP (easiest for dev).
# Get a Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"

# Email — SendGrid (alternative, for production).
# Create API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@example.com"

# Frontend URL — for CORS and links in emails.
FRONTEND_URL="http://localhost:5173"

# Admin app URL (optional) — for CORS when admin app is on a different origin.
# ADMIN_FRONTEND_URL="http://localhost:5174"

# Server port (optional; default 3003)
PORT=3003

# AI (optional) — OpenAI API key for "Suggest category" on expenses. If unset, the feature returns 503.
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
