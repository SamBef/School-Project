# =============================================================================
# KoboTrack API — environment variables
# Copy this file to .env in this folder and fill in the values.
# See docs/configuration-guide.md for a clear, step-by-step guide.
# =============================================================================

# --- Database (required) ---
# PostgreSQL connection. Use the same value for both for Supabase or local.
# Supabase: Project Settings → Database → Connection string (URI). Replace [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# Dev only (Windows): set to 1 if you see a TLS/credentials error. Never set in production.
# DATABASE_INSECURE_SSL=1

# --- Security (required) ---
# Long random string for signing JWTs. Never commit the real value.
JWT_SECRET="your-jwt-secret-change-in-production"

# --- Email (required: choose Gmail OR SendGrid) ---
# Option A — Gmail (easiest for dev): https://myaccount.google.com/apppasswords
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"

# Option B — SendGrid (for production): https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@example.com"

# --- URLs (required) ---
# Web app URL — for CORS and links in emails (e.g. invite, password reset).
FRONTEND_URL="http://localhost:5173"

# Admin app URL (optional) — only if admin runs on a different origin.
# ADMIN_FRONTEND_URL="http://localhost:5174"

# --- Server (optional) ---
# Port the API listens on. Default 3005.
PORT=3005

# --- Optional features ---
# OpenAI — for "Suggest category" on expenses. If unset, feature returns 503.
# OPENAI_API_KEY="sk-..."
