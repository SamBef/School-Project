# =============================================================================
# KoboTrack Web app — environment variables
# Copy this file to .env in this folder and set VITE_API_URL.
# See docs/configuration-guide.md for a clear, step-by-step guide.
# =============================================================================

# --- Required ---
# Base URL of the API (no trailing slash). The web app uses this for all API calls.
# Local: use the same host/port as your API (default 3005). Production: your API domain.
VITE_API_URL=http://localhost:3005
