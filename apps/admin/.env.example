# API base URL for the admin app. In dev with Vite proxy, leave unset to use proxy (default target localhost:3004).
# Use VITE_ADMIN_API_URL to point the admin app at a different backend than the main app (e.g. different host/port or even a separate API with its own database).
#
# Examples:
#   Same API as main app (default in dev): leave both unset, or set VITE_API_URL if you use it for build.
#   Admin on a different API server:  VITE_ADMIN_API_URL="http://localhost:3005"
#   Production admin API:           VITE_ADMIN_API_URL="https://admin-api.yourdomain.com"
#
# VITE_API_URL="http://localhost:3004"
# VITE_ADMIN_API_URL="http://localhost:3005"
