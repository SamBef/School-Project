# =============================================================================
# KoboTrack Admin app — environment variables (optional)
# Copy this file to .env only if the admin app must use a different API URL.
# See docs/configuration-guide.md for a clear, step-by-step guide.
# =============================================================================

# In dev, leaving this file absent uses the Vite proxy (default: same API as main app).

# Same API as main app (e.g. for production build):
# VITE_API_URL="http://localhost:3004"

# Different API for admin (e.g. separate backend):
# VITE_ADMIN_API_URL="http://localhost:3005"
